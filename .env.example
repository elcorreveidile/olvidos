# ============================================
# BASE DE DATOS (Neon PostgreSQL)
# ============================================
# Obtén una URL gratuita en https://neon.tech
DATABASE_URL="postgresql://user:password@host/olvidos?sslmode=require"

# ============================================
# NEXTAUTH (Autenticación)
# ============================================
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"  # Cambiar a la URL de Vercel en producción
NEXTAUTH_SECRET="your-secret-here"

# ============================================
# STRIPE (Pagos y Membresías)
# ============================================
# Obtén las claves en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."  # Se obtiene al configurar el webhook en Stripe

# Precios de membresía (en centimos: 3000 = 30€, 6000 = 60€, etc.)
STRIPE_PRICE_STANDARD="3000"
STRIPE_PRICE_COLLABORATOR="6000"
STRIPE_PRICE_HONORARY="12000"
STRIPE_PRICE_INSTITUTIONAL="25000"

# ============================================
# ALMACENAMIENTO (Cloudflare R2 - Opcional)
# ============================================
# Para imágenes y archivos. Usa Vercel Blob como alternativa
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="olvidos-media"

# ============================================
# EMAIL (Resend - Opcional)
# ============================================
# Obtenén API key en https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="info@olvidosdegranada.es"
RESEND_AUDIENCE_ID=""  # ID de audiencia para newsletters

# ============================================
# APLICACIÓN
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Cambiar a la URL de Vercel en producción

# ============================================
# GOOGLE ANALYTICS (Opcional)
# ============================================
NEXT_PUBLIC_GA_ID=""  # Ejemplo: G-XXXXXXXXXX

# ============================================
# MAPAS (Opcional)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""  # Para mostrar ubicaciones de eventos
