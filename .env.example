# ============================================
# BASE DE DATOS (Neon PostgreSQL)
# ============================================
# Obtén una URL gratuita en https://neon.tech
DATABASE_URL="postgresql://user:password@host/olvidos?sslmode=require"

# ============================================
# AUTENTICACIÓN (NextAuth v5 / Auth.js)
# ============================================
# Genera un secreto con: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Credenciales de la OAuth App de GitHub (Settings > Developer settings)
AUTH_GITHUB_ID="your-github-oauth-app-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-secret"

# Login con Google (opcional). Crea un cliente OAuth 2.0 (tipo "Aplicación web")
# en Google Cloud Console > Google Auth Platform > Clientes. El Client ID y el
# Client Secret son LOS MISMOS en desarrollo y en producción: solo hay que añadir
# en ese cliente las URLs de cada entorno.
#   Orígenes de JavaScript autorizados:
#     http://localhost:3000        (desarrollo)
#     https://olvidos.es           (producción)
#   URIs de redireccionamiento autorizados:
#     http://localhost:3000/api/auth/callback/google   (desarrollo)
#     https://olvidos.es/api/auth/callback/google       (producción)
# En producción, además, publica la app en "Google Auth Platform > Público" para
# que pueda entrar cualquier usuario (en modo Prueba solo entran los de prueba).
# Si dejas estas vars vacías, el botón de Google no se activa.
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# El enlace mágico (login sin contraseña) NO necesita claves nuevas: usa
# AUTH_SECRET + Resend (RESEND_API_KEY/EMAIL_FROM) ya definidos más abajo.

# Compatibilidad con nombres antiguos de NextAuth (aún referenciados en el código)
NEXTAUTH_SECRET="your-secret-here"
# URL base de la app. Debe coincidir con el dominio real para que los callbacks
# de OAuth (Google/GitHub) y los enlaces mágicos apunten bien.
#   Desarrollo:  http://localhost:3000
#   Producción:  https://olvidos.es
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 detrás de un proxy (Vercel) necesita confiar en el host en producción.
AUTH_TRUST_HOST="true"

# ============================================
# STRIPE (Pagos y Membresías)
# ============================================
# Obtén las claves en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."  # Se obtiene al configurar el webhook en Stripe

# NOTA: no hace falta crear productos/precios en el panel de Stripe. Los importes
# de las cuotas (50€/120€/250€ anuales) se definen en código (src/lib/stripe.ts,
# MEMBERSHIP_PLANS) y el precio se crea al vuelo con price_data. Solo necesitas
# las claves de arriba (secret + publishable) y el webhook.

# ============================================
# ALMACENAMIENTO DE DOCUMENTOS (Vercel Blob)
# ============================================
# Los PDFs de la sección de documentos (estatutos, actas, libro de socios) se
# guardan en Vercel Blob. Conecta Blob Storage en el panel de Vercel (Storage >
# Create > Blob) y pega aquí el token que te da. En local, sin este token, la
# subida no funciona (pero el resto de la web sí).
BLOB_READ_WRITE_TOKEN=""

# ============================================
# ALMACENAMIENTO (Cloudflare R2 - alternativa, opcional)
# ============================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="olvidos-media"

# ============================================
# EMAIL (Resend)
# ============================================
# Obtén API key en https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Remitente de los correos automáticos. DEBE ser de un dominio verificado en
# Resend (resend.com/domains). No sirve un gmail. Recomendado: no-reply@olvidos.es
EMAIL_FROM="no-reply@olvidos.es"
# Buzones de administración donde llegan los mensajes del formulario de contacto.
# Puedes poner varios separados por coma (llega a todos).
CONTACT_TO="olvidosdegranada@gmail.com,informa@blablaele.com"
RESEND_AUDIENCE_ID=""  # ID de audiencia para newsletters

# ============================================
# APLICACIÓN
# ============================================
# URL pública de la app (se usa para construir los enlaces mágicos y compartir).
#   Desarrollo:  http://localhost:3000
#   Producción:  https://olvidos.es
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# GOOGLE ANALYTICS (Opcional)
# ============================================
NEXT_PUBLIC_GA_ID=""  # Ejemplo: G-XXXXXXXXXX

# ============================================
# MAPAS (Opcional)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""  # Para mostrar ubicaciones de eventos
